#!/usr/bin/env bash
# Cubby server: one always-on Syncthing peer that receives, redistributes and
# versions the folder. Everything talks to the local Syncthing REST API, which
# listens on a socket under /run/cubby that nothing outside the container reaches.
#
# Run these through the container: docker exec cubby cubby status
#
#   cubby add NAME DEVICE-ID      add a device and share the folder with it
#   cubby remove NAME|DEVICE-ID   revoke a device
#   cubby revert                  drop files changed or created on the server itself
#   cubby status                  devices, last seen, folder state
#   cubby health                  print only what is wrong, and exit non-zero when it does
#   cubby id                      the server's device ID
#   cubby configure               re-apply options and folder settings; the entrypoint runs it at start
#
# Settings come from the container environment, which compose fills from .env:
#   CUBBY_FOLDER        /srv/cubby/Cubby   the synced folder
#   CUBBY_STHOME        /srv/cubby/config  Syncthing's identity, config and database
#   CUBBY_MAX_AGE_DAYS  365                keep old versions this long, 0 forever
#   CUBBY_DISK_PCT      85                 health: warn at this usage
#   CUBBY_STALE_DAYS    7                  health: warn when a device has been away this long
set -euo pipefail

home=${CUBBY_HOME:-/srv/cubby}
folder=${CUBBY_FOLDER:-$home/Cubby}
sthome=${CUBBY_STHOME:-$home/config}
max_age_days=${CUBBY_MAX_AGE_DAYS:-365}
disk_pct=${CUBBY_DISK_PCT:-85}
stale_days=${CUBBY_STALE_DAYS:-7}
folder_id=cubby
sock=${CUBBY_SOCK:-/run/cubby/api.sock}

die() { echo "cubby: $*" >&2; exit 1; }
usage() { awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" >&2; exit 1; }
is_device_id() { [[ $1 =~ ^([A-Z2-7]{7}-){7}[A-Z2-7]{7}$ ]]; }

# The image carries no column(1); pad the tab-separated fields instead.
columns() {
    awk -F'\t' '
        { for (i = 1; i <= NF; i++) { if (length($i) > w[i]) w[i] = length($i); cell[NR, i] = $i }
          nf[NR] = NF; rows = NR }
        END { for (r = 1; r <= rows; r++) {
                  line = ""
                  for (i = 1; i <= nf[r]; i++) {
                      s = cell[r, i]
                      if (i < nf[r]) { n = w[i] - length(s) + 2; while (n-- > 0) s = s " " }
                      line = line s
                  }
                  print line } }'
}

apikey() {
    local key
    key=$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$sthome/config.xml" 2>/dev/null | head -1)
    [ -n "$key" ] || die "no API key in $sthome/config.xml; is the config volume mounted?"
    printf '%s' "$key"
}

# api METHOD PATH [JSON]. Prints the body; dies with Syncthing's message on HTTP errors.
api() {
    local method=$1 path=$2 body=${3-} key resp code
    key=$(apikey) || exit 1
    resp=$(curl -sS -w '\n%{http_code}' --unix-socket "$sock" -X "$method" -H "X-API-Key: $key" -H 'Content-Type: application/json' \
        ${body:+--data-binary "$body"} "http://localhost/rest/$path") || die "cannot reach Syncthing at $sock; check: docker logs cubby"
    code=${resp##*$'\n'}
    resp=${resp%$'\n'*}
    [[ $code = 2* ]] || die "$method $path: HTTP $code${resp:+: $resp}"
    printf '%s' "$resp"
}

# api_code METHOD PATH: prints only the HTTP status (000 when unreachable), never fails.
api_code() {
    local key
    key=$(apikey) || exit 1
    curl -s -o /dev/null -w '%{http_code}' --unix-socket "$sock" -X "$1" -H "X-API-Key: $key" "http://localhost/rest/$2" || true
}

wait_api() {
    for _ in $(seq 1 60); do
        [ "$(api_code GET system/status)" = 200 ] && return 0
        sleep 1
    done
    die "Syncthing API not reachable at $sock"
}

my_id() { api GET system/status | jq -r .myID; }

folder_json() {
    jq -n --arg path "$folder" --arg maxage "$((max_age_days * 86400))" '{
        id: "cubby", label: "Cubby", path: $path,
        type: "receiveonly",
        rescanIntervalS: 3600, fsWatcherEnabled: true, fsWatcherDelayS: 10,
        ignorePerms: true, autoNormalize: true, maxConflicts: -1,
        versioning: { type: "staggered", params: { maxAge: $maxage }, cleanupIntervalS: 3600, fsPath: "", fsType: "basic" }
    }'
}

cmd_configure() {
    wait_api
    api PATCH config/options '{
        "listenAddresses": ["tcp://0.0.0.0:22000"],
        "globalAnnounceEnabled": false, "localAnnounceEnabled": false,
        "relaysEnabled": false, "natEnabled": false,
        "urAccepted": -1, "crashReportingEnabled": false,
        "startBrowser": false, "autoUpgradeIntervalH": 0
    }' >/dev/null
    api PATCH config/gui "$(jq -n --arg a "unix://$sock" '{address: $a, useTLS: false, unixSocketPermissions: "0600"}')" >/dev/null
    # Syncthing 2 creates no default folder; a config carried over from 1 may have one.
    [ "$(api_code GET config/folders/default)" = 404 ] || api DELETE config/folders/default >/dev/null
    # PATCH keeps the device list, POST creates without one; the local device is implied.
    if [ "$(api_code GET "config/folders/$folder_id")" = 200 ]; then
        api PATCH "config/folders/$folder_id" "$(folder_json)" >/dev/null
    else
        # Syncthing writes .stfolder itself only when it creates the directory, and a
        # mounted one always exists already. Seed the marker here, on the one start
        # that first defines the folder: afterwards a missing marker means the mount
        # is gone, and Syncthing should stop and say so rather than fetch it all again.
        install -d -o "${PUID:-1000}" -g "${PGID:-1000}" "$folder/.stfolder"
        api POST config/folders "$(folder_json)" >/dev/null
    fi
    if [ "$(api GET config/restart-required | jq -r .requiresRestart)" = true ]; then
        # Syncthing's own monitor process re-execs it, so the container stays up.
        api POST system/restart >/dev/null
        sleep 2
        wait_api
    fi
}

cmd_add() {
    local name=${1-} id=${2-} taken shared
    id=${id^^}
    [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "usage: cubby add NAME DEVICE-ID"
    is_device_id "$id" || die "not a device ID: ${2-}"
    [ "$id" != "$(my_id)" ] || die "$id is the server itself"
    taken=$(api GET config/devices | jq -r --arg n "$name" --arg id "$id" '.[] | select(.name == $n and .deviceID != $id) | .deviceID')
    [ -z "$taken" ] || die "name $name already belongs to $taken"
    if [ "$(api_code GET "config/devices/$id")" = 200 ]; then
        api PATCH "config/devices/$id" "$(jq -n --arg n "$name" '{name: $n}')" >/dev/null
    else
        api POST config/devices "$(jq -n --arg n "$name" --arg id "$id" '{deviceID: $id, name: $n, addresses: ["dynamic"]}')" >/dev/null
    fi
    shared=$(api GET "config/folders/$folder_id" \
        | jq --arg id "$id" 'if any(.devices[]; .deviceID == $id) then . else .devices += [{deviceID: $id}] end')
    api PUT "config/folders/$folder_id" "$shared" >/dev/null
    echo "added $name; on that device add the server and the cubby folder"
}

cmd_remove() {
    local arg=${1-} id
    [ -n "$arg" ] || die "usage: cubby remove NAME|DEVICE-ID"
    if is_device_id "${arg^^}"; then
        id=${arg^^}
        [ "$id" != "$(my_id)" ] || die "$id is the server itself"
        [ "$(api_code GET "config/devices/$id")" = 200 ] || die "no device $id"
    else
        id=$(api GET config/devices | jq -r --arg n "$arg" --arg me "$(my_id)" '.[] | select(.name == $n and .deviceID != $me) | .deviceID')
        [ -n "$id" ] || die "no device named $arg"
        [[ $id != *$'\n'* ]] || die "several devices are named $arg; remove one by ID: ${id//$'\n'/ }"
    fi
    api DELETE "config/devices/$id" >/dev/null
    echo "removed $arg"
}

cmd_revert() {
    api POST "db/revert?folder=$folder_id" >/dev/null
    echo "reverted; the devices' copies win"
}

cmd_status() {
    local me conns stats
    me=$(my_id)
    conns=$(api GET system/connections)
    stats=$(api GET stats/device)
    echo "server $me"
    api GET config/devices | jq -r --arg me "$me" --argjson c "$conns" --argjson s "$stats" '
        .[] | select(.deviceID != $me)
        | [.name, "connected=\($c.connections[.deviceID].connected // false)",
           "last seen \($s[.deviceID].lastSeen // "never" | if startswith("1970-") then "never" else . end)"] | @tsv' \
        | columns
    api GET "db/status?folder=$folder_id" | jq -r '
        "folder \(.state), \(.globalFiles) files, \(.globalBytes) bytes, \(.needBytes) bytes pending, "
        + "\(.receiveOnlyChangedFiles) changed on the server, \(.pullErrors) failed"'
}

# Prints only what is wrong and exits non-zero when it prints, so the container's
# HEALTHCHECK turns the same report into an unhealthy status.
cmd_health() {
    local out="" pct now conns stats folder_err stale
    [ -d "$folder" ] || { echo "cubby: folder $folder is missing"; return 1; }
    pct=$(df --output=pcent "$folder" | tail -1 | tr -dc 0-9)
    [ "${pct:-0}" -lt "$disk_pct" ] || out+="cubby: disk ${pct}% full at $folder"$'\n'
    if [ "$(api_code GET system/status)" != 200 ]; then
        printf '%scubby: Syncthing API down at %s; check: docker logs cubby\n' "$out" "$sock"
        return 1
    fi
    folder_err=$(api GET "db/status?folder=$folder_id" | jq -r '
        select(.state == "error" or .pullErrors > 0)
        | "cubby: folder \(.state), \(.pullErrors) items failed to sync" + (if (.error // "") != "" then ": " + .error else "" end)')
    [ -z "$folder_err" ] || out+="$folder_err"$'\n'
    now=$(date +%s)
    conns=$(api GET system/connections)
    stats=$(api GET stats/device)
    # Disconnected devices with a real last-seen time; never-connected ones appear in status instead.
    stale=$(api GET config/devices | jq -r --argjson c "$conns" --argjson s "$stats" '
        .[] | select(($c.connections[.deviceID].connected // false) | not)
        | [.name, ($s[.deviceID].lastSeen // "")]
        | select(.[1] != "" and (.[1] | startswith("1970-") | not)) | @tsv' \
    | while IFS="$(printf '\t')" read -r name seen; do
        [ $((now - $(date -d "$seen" +%s))) -lt $((stale_days * 86400)) ] || echo "cubby: $name last seen $seen"
    done)
    [ -z "$stale" ] || out+="$stale"$'\n'
    [ -z "$out" ] || { printf '%s' "$out"; return 1; }
}

case "${1-}" in
    configure) cmd_configure ;;
    add)       cmd_add "${2-}" "${3-}" ;;
    remove)    cmd_remove "${2-}" ;;
    revert)    cmd_revert ;;
    status)    cmd_status ;;
    health)    cmd_health ;;
    id)        my_id ;;
    *)         usage ;;
esac
