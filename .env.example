# Copy to .env and uncomment what you need; the values shown are the defaults.

# Address Docker publishes 2222 on. Docker bypasses host firewalls such as
# ufw, so a VPN or LAN address is safer when exposed.
#CUBBY_BIND_ADDR=0.0.0.0

# Seconds between snapshots of data/shared/ into data/backups/, and how
# many snapshots to keep.
#CUBBY_BACKUP_INTERVAL=3600
#CUBBY_BACKUP_KEEP=168
