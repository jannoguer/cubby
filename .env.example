# Copy to .env and edit. Every line is optional; the defaults shown are what
# compose uses when the file is absent.

# Owner of the synced files on the host. `id -u` and `id -g` for the account
# that should be able to read them; leave them alone if you only reach the
# files through the container.
PUID=1000
PGID=1000

# Where the two volumes live on the host. Point CUBBY_DATA at the big disk.
CUBBY_DATA=./data
CUBBY_CONFIG=./config

# Published sync port. Change it only if 22000 is taken; the devices have to
# use the same number in the server's address.
CUBBY_PORT=22000

# Keep old versions this long. 0 keeps them forever.
CUBBY_MAX_AGE_DAYS=365

# health: warn above this disk usage, and when a device has been away this long.
CUBBY_DISK_PCT=85
CUBBY_STALE_DAYS=7
