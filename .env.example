# Copy to .env and uncomment what you need; the values shown are the defaults.

# Docker publishes past host firewalls such as ufw; bind to a VPN or LAN address.
#CUBBY_BIND_ADDR=0.0.0.0

# Seconds between snapshots of shared/ into backups/.
#BACKUP_INTERVAL=3600
# Snapshots kept: newest per hour, first per day, first per ISO week.
#BACKUP_KEEP_HOURLY=24
#BACKUP_KEEP_DAILY=14
#BACKUP_KEEP_WEEKLY=8

# ntfy topic URL (e.g. https://ntfy.sh/your-topic): backup failures from the
# server, sync health and conflicts from every client running watch.ps1. Empty disables.
#NTFY_URL=

# Mirror backups/ to another machine after every snapshot (rsync over ssh with
# offsite/id_ed25519 and offsite/known_hosts). Empty disables.
#BACKUP_REMOTE=user@host:/path/to/cubby-backups
#BACKUP_REMOTE_PORT=22
