# Copy to .env and uncomment what you need; the values shown are the defaults.

# Docker publishes past host firewalls such as ufw; bind to a VPN or LAN address.
#CUBBY_BIND_ADDR=0.0.0.0

# Seconds between snapshots of data/shared/ into data/backups/, and how many to keep.
#CUBBY_BACKUP_INTERVAL=3600
#CUBBY_BACKUP_KEEP=168
