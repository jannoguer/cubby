# Copy to .env and uncomment what you need; the values shown are the defaults.

# Address and host port Docker publishes sshd on. Docker bypasses host
# firewalls such as ufw, so a VPN or LAN address is safer when exposed.
#CUBBY_BIND_ADDR=0.0.0.0
#CUBBY_PORT=2222

# Seconds between snapshots of data/shared/ into data/backups/ (and of
# data/private/ into data/private-backups/), and how many snapshots to keep.
# An interval with no changes writes no snapshot.
#CUBBY_BACKUP_INTERVAL=3600
#CUBBY_BACKUP_KEEP=168
