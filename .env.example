# Copy to .env. Commented lines show the defaults, uncomment one to override it.

# --- SSH: address and port to publish on. Docker bypasses ufw, so prefer a VPN or LAN IP.
#CUBBY_BIND_ADDR=0.0.0.0
#CUBBY_PORT=2222

# --- Snapshots: seconds between them (skipped if there are no changes), and how many to keep.
#CUBBY_BACKUP_INTERVAL=3600
#CUBBY_BACKUP_KEEP=168

# --- Web view (README, Web): the password is required once enabled, and empty means no login.
#COMPOSE_PROFILES=web
#CUBBY_WEB_PASSWORD=
#CUBBY_WEB_BIND_ADDR=127.0.0.1
#CUBBY_WEB_PORT=8080
